{
  "name": "snap-gen-ai-studio",
  "productName": "SnapGen AI Studio",
  "version": "1.0.0",
  "description": "Multi-scene AI video studio: ChatGPT script, Snapgen video/image, OpenAI TTS & Whisper subs",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "clean": "node -e \"require('fs').rmSync('.vite',{recursive:true,force:true}); require('fs').rmSync('out',{recursive:true,force:true});\""
  },
  "keywords": [
    "electron",
    "ai-video",
    "snapgen",
    "openai",
    "whisper"
  ],
  "author": "SnapGen",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.4": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true
  }
}
